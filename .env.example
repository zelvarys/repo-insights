# ─── Local development ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://user@localhost:5432/repositron
REDIS_URL=redis://localhost:6379

GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ─── Production Docker Compose overrides ─────────────────────────────────────
# On the VPS, comment out the development values above and uncomment these.
# Keep the password in DATABASE_URL URL-encoded if it contains special chars.
# NODE_ENV=production
# PORT=3000
# LOG_LEVEL=info
# FRONTEND_URL=https://repositron.example.com
# TRUST_PROXY=1
# POSTGRES_USER=repositron
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=repositron
# DATABASE_URL=postgres://repositron:change-me@postgres:5432/repositron
# REDIS_URL=redis://redis:6379
# REDIS_MAXMEMORY=256mb
# SCAN_RETENTION_DAYS=90
# GITHUB_CALLBACK_URL=https://repositron.example.com/auth/github/callback

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_FETCH_TIMEOUT_MS=15000

# ─── App secrets ──────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=

# Frontend: leave empty to use the Vite dev proxy.
VITE_API_URL=

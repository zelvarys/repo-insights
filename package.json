{
  "name": "repo-insights",
  "version": "0.1.0",
  "private": true,
  "description": "Repository health dashboard for activity, dependencies, workflows, structure, contributors, commit quality, and tool adoption.",
  "type": "module",
  "main": "dist/server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "worker": "tsx watch server/modules/scans/scan.worker.ts",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p config/typescript/server.json",
    "build:frontend": "tsc -p config/typescript/app.json && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node dist/server/server.js",
    "migrate": "node scripts/migrate.js",
    "typecheck": "tsc -p config/typescript/server.json --noEmit",
    "typecheck:frontend": "tsc -p config/typescript/app.json --noEmit",
    "typecheck:node": "tsc -p config/typescript/node.json --noEmit",
    "typecheck:test": "tsc -p config/typescript/test.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend && npm run typecheck:node && npm run typecheck:test",
    "lint": "eslint .",
    "format": "prettier --write \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "bullmq": "^5.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.2.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.0.2",
    "eslint": "^9.6.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vitest": "^2.0.2"
  }
}
